# Secrets and local state: never baked into an image
.env
.env.*
uploads
*.log
# Not needed to run the server
.git
.github
node_modules
docs/*
# ...except the help corpus: Zarvia AI answers from it at runtime, so an image without it
# loads zero topics and every answer becomes "I have nothing reliable to tell you".
!docs/help
scripts
**/__tests__
Dockerfile
.dockerignore
render.yaml
